# Model cấu hình (chỉ dùng duy nhất qwen2.5-7b-legal-vn-Q4_K_M.gguf)
MODEL_ID=qwen2.5-7b-legal-vn
MODEL_DIR=models/qwen2.5-7b-legal-vn-Q4_K_M.gguf

LLAMA_SERVER_URL=http://127.0.0.1:8088/v1
# LLM_FIRST=1: ưu tiên gọi Fine-tuned LLM (Qwen2.5-7B) khi llama-server sẵn sàng
LLM_FIRST=1
LLM_TIMEOUT_MS=120000

MAX_NEW_TOKENS=2048
TEMPERATURE=0.2
TOP_P=0.85
MAX_HISTORY_TURNS=4
CPU_THREADS=4

# Cấu hình MongoDB (Nếu không điền, hệ thống tự động fallback in-memory)
MONGODB_URI=mongodb://127.0.0.1:27017/vietlaw_assist
JWT_SECRET=vietlaw_secret_key_pbl6_2026_dut

# Cấu hình gửi Mail OTP từ Gmail
SMTP_USER=your_email@gmail.com
# Mật khẩu ứng dụng 16 ký tự của Google (Tạo tại: https://myaccount.google.com/apppasswords)
SMTP_PASS=your_google_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
